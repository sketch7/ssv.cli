{
  "name": "@ssv/cli",
  "version": "1.5.0",
  "private": false,
  "description": "@ssv developer tooling CLI",
  "license": "MIT",
  "author": "Stephen Lautier <stephen.lautier@outlook.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sketch7/ssv.cli.git"
  },
  "bin": {
    "ssv": "dist/cli.mjs"
  },
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown -w",
    "start": "node dist/cli.mjs",
    "gen-schema": "node scripts/gen-schema.ts",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt . --check",
    "typecheck": "tsc --noEmit",
    "__CI__": "",
    "release": "npm publish"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "consola": "^3.4.2",
    "execa": "^10.0.1",
    "listr2": "^11.0.0",
    "update-notifier": "^7.3.1",
    "valibot": "^1.4.2",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/update-notifier": "^6.0.8",
    "@valibot/to-json-schema": "^1.7.1",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "oxlint-tsgolint": "^7.0.2001",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.18.0"
}
